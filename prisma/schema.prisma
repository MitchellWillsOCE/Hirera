// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Authentication Model
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  country       String?   @default("US")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isPublic      Boolean   @default(false)
  
  // Relations
  accounts        Account[]
  sessions        Session[]
  jobApplications JobApplication[]
  activityLogs    ActivityLog[]
  analytics       Analytics[]
  notifications   Notification[]
  goals           Goal[]
  achievements    Achievement[]
  
  @@map("users")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Job Application Microservice Models
model JobApplication {
  id              String    @id @default(cuid())
  jobTitle        String
  company         String
  location        String
  jobPostUrl      String?
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?   @default("USD")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  notes           String?
  status          JobStatus @default(APPLIED)
  priority        Priority  @default(MEDIUM)
  appliedDate     DateTime  @default(now())
  lastUpdated     DateTime  @updatedAt
  userId          String
  
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags         JobApplicationTag[]
  activityLogs ActivityLog[]
  
  @@map("job_applications")
}

model Tag {
  id               String              @id @default(cuid())
  name             String              @unique
  createdAt        DateTime            @default(now())
  jobApplications  JobApplicationTag[]
  
  @@map("tags")
}

model JobApplicationTag {
  id               String         @id @default(cuid())
  jobApplicationId String
  tagId            String
  
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  tag              Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([jobApplicationId, tagId])
  @@map("job_application_tags")
}

// Activity Logging Microservice
model ActivityLog {
  id               String         @id @default(cuid())
  userId           String
  jobApplicationId String
  action           String
  description      String
  timestamp        DateTime       @default(now())
  
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  
  @@map("activity_logs")
}

// Template Management Microservice
model Template {
  id          String   @id @default(cuid())
  name        String
  content     String
  type        TemplateType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("templates")
}

// Analytics Microservice Models
model Analytics {
  id              String   @id @default(cuid())
  userId          String
  period          String   // 'daily', 'weekly', 'monthly'
  date            DateTime
  totalApps       Int      @default(0)
  responsesRate   Float    @default(0)
  interviewRate   Float    @default(0)
  offerRate       Float    @default(0)
  avgResponseTime Int      @default(0)
  createdAt       DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, period, date])
  @@map("analytics")
}

// Notification Microservice
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

// Enums
enum JobStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TemplateType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  OTHER
}

enum NotificationType {
  REMINDER
  ACHIEVEMENT
  GOAL_PROGRESS
  SYSTEM
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  type        GoalType
  target      Int
  period      GoalPeriod
  startDate   DateTime
  endDate     DateTime
  achieved    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String    @id @default(cuid())
  userId      String
  type        AchievementType
  title       String
  description String
  unlockedAt  DateTime  @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GoalType {
  APPLICATIONS
  INTERVIEWS
  OFFERS
  RESPONSES
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AchievementType {
  FIRST_APPLICATION
  FIRST_INTERVIEW
  FIRST_OFFER
  MILESTONE_10_APPS
  MILESTONE_50_APPS
  MILESTONE_100_APPS
  STREAK_7_DAYS
  STREAK_30_DAYS
  PERFECT_WEEK
  GOAL_ACHIEVER
}
