# Production Environment Configuration for Hirera.net
# Copy this file to .env.production and fill in your actual values

# ================================
# Auth Microservice Configuration
# ================================
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.hirera.net

# ================================
# AWS Configuration
# ================================
AWS_REGION=ap-southeast-2
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-2

# For services that need direct AWS access (not auth microservice)
AWS_ACCESS_KEY_ID=your_production_access_key
AWS_SECRET_ACCESS_KEY=your_production_secret_key

# ================================
# Cognito Configuration (if needed for other services)
# ================================
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-2_2crlAC0JH
NEXT_PUBLIC_COGNITO_CLIENT_ID=fivu1tamshltc854dak86c1um

# ================================
# Application Configuration
# ================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://hirera.net

# ================================
# Database Configuration
# ================================
DATABASE_URL=your_production_database_url
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1

# ================================
# Security Configuration
# ================================
NEXTAUTH_SECRET=your_production_nextauth_secret_min_32_chars
NEXTAUTH_URL=https://hirera.net

# ================================
# Third-party Service Configuration
# ================================
# LinkedIn Integration (if applicable)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id

# Email Service (if needed)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# ================================
# Feature Flags
# ================================
ENABLE_ANALYTICS=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ================================
# Performance Configuration
# ================================
REDIS_URL=your_redis_url_for_session_storage
REDIS_TLS_URL=your_redis_tls_url_if_needed

# ================================
# Monitoring and Logging
# ================================
SENTRY_DSN=your_sentry_dsn_for_error_tracking
LOG_LEVEL=warn 