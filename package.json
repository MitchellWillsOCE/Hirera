  "description": "Hirera Job Tracking Platform - Microservices Architecture",
  "private": true,
  "scripts": {
    "dev": "echo \"To run the development server, please 'cd web-app' first, then run 'npm run dev'\"",
    "build": "echo \"To build the project, please 'cd web-app' first, then run 'npm run build'\"",
    "start": "echo \"To start the production server, please 'cd web-app' first, then run 'npm run start'\"",
    "lint": "cd web-app && npm run lint",
    "install-all": "cd web-app && npm install",
    "clean": "cd web-app && npm run clean"
  },
  "workspaces": [
    "web-app"
  ],
