    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "ts-jest": "^29.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
